{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/commodities.js": {
      "maxDuration": 30
    },
    "api/config.js": {
      "maxDuration": 10
    },
    "api/providers.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/commodities",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    }
  ]
}
